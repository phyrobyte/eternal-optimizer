from typing import Any, Optional, Sequence, Tuple

ParamSpec = Sequence[Tuple[str, float, float]]

class Options:
    warmup: int
    bins: int
    gamma: float
    half_life: float
    k_sigma: float
    zoom_z: float
    zoom_min_n: float
    recheck_every: int
    stall_reset: int
    local_share: float
    recall_share: float
    recall_spread: float
    recall_zoom: float
    recall_confirm: int
    def __init__(self) -> None: ...

class Memory:
    @property
    def studies(self) -> int: ...
    def __init__(self) -> None: ...
    def save(self) -> str: ...
    @staticmethod
    def load(text: str) -> Memory: ...

class _Optimizer:
    def __init__(self, params: ParamSpec, seed: int = 0, options: Options = ...,
                 memory: Optional[Memory] = None) -> None: ...
    def ask(self) -> list[float]: ...
    def tell(self, y: float) -> None: ...
    def remember(self, previous: Optional[Memory] = None, forget_half_life: float = 0.0) -> Memory: ...
    @property
    def names(self) -> list[str]: ...
    @property
    def best(self) -> float: ...
    @property
    def incumbent(self) -> list[float]: ...
    @property
    def noise(self) -> float: ...
    @property
    def screened(self) -> bool: ...
    @property
    def has_memory(self) -> bool: ...
    @property
    def region_lo(self) -> list[float]: ...
    @property
    def region_hi(self) -> list[float]: ...
    @property
    def pending_kind(self) -> str: ...
    @property
    def verdicts(self) -> list[dict[str, Any]]: ...
    @property
    def trials(self) -> list[dict[str, Any]]: ...
    @property
    def events(self) -> list[dict[str, Any]]: ...

class _RandomSearch:
    def __init__(self, params: ParamSpec, seed: int = 0) -> None: ...
    def ask(self) -> list[float]: ...
    def tell(self, y: float) -> None: ...
    @property
    def best(self) -> float: ...
